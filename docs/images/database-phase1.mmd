%%{init: {'theme':'neutral', 'themeVariables': {'fontSize':'15px'}}}%%
erDiagram
    MODEL_KIND ||--o{ MODEL : "kind"
    MODEL |o--o{ MODEL : "parent (copied from / branch of)"
    MODEL ||--o{ LAYER : "owns"
    MODEL ||--o{ ENTITY_TYPE : "owns"
    MODEL ||--o{ RELATIONSHIP_TYPE : "owns"
    MODEL ||--o{ ATTRIBUTE_TYPE : "owns"
    MODEL ||--o{ PICK_LIST : "owns"
    MODEL ||--o{ ENTITY : "contains"
    MODEL ||--o{ RELATIONSHIP : "contains"
    LAYER ||--o{ ENTITY_TYPE : "groups"
    PICK_LIST ||--o{ PICK_LIST_VALUE : "values"
    PICK_LIST |o--o{ ATTRIBUTE_TYPE : "values from"
    DATA_TYPE ||--o{ ATTRIBUTE_TYPE : "typed as"
    ATTRIBUTE_TYPE ||--o{ ITEM_ATTRIBUTE : "applies via"
    ENTITY_TYPE |o--o{ ITEM_ATTRIBUTE : "has"
    RELATIONSHIP_TYPE |o--o{ ITEM_ATTRIBUTE : "has"
    ATTRIBUTE_TYPE |o--o{ VALIDATION_RULE : "checked by"
    RULE_TYPE ||--o{ VALIDATION_RULE : "rule"
    RELATIONSHIP_TYPE ||--o{ ALLOWED_RELATIONSHIP : "allowed as"
    ENTITY_TYPE ||--o{ ALLOWED_RELATIONSHIP : "source / target"
    ENTITY_TYPE ||--o{ ENTITY : "typed by"
    ENTITY |o--o{ ENTITY : "parent"
    RELATIONSHIP_TYPE ||--o{ RELATIONSHIP : "typed by"
    ENTITY ||--o{ RELATIONSHIP : "source / target"
    ENTITY |o--o{ ATTRIBUTE_VALUE : "has"
    RELATIONSHIP |o--o{ ATTRIBUTE_VALUE : "has"
    ATTRIBUTE_TYPE ||--o{ ATTRIBUTE_VALUE : "typed by"
    ITEM_STATUS ||--o{ ENTITY : "status (every table)"

    MODEL {
        bigint id PK
        uuid guid UK
        text name
        text kind_code FK "template reference project branch"
        bigint parent_model_id FK
        text metamodel_name "ArchiMate 4"
        int metamodel_version
        bool is_locked "read-only"
    }
    LAYER {
        bigint id PK
        bigint model_id FK
        text code
        text name "Business, Application..."
        text colour
    }
    ENTITY_TYPE {
        bigint id PK
        bigint model_id FK
        bigint layer_id FK
        text code "ApplicationComponent"
        text name "Application Component"
        text id_prefix "APP"
        text table_name "application_component"
    }
    RELATIONSHIP_TYPE {
        bigint id PK
        bigint model_id FK
        text code "Serving"
        text verb "serves"
        text category
        bool is_directed
    }
    ATTRIBUTE_TYPE {
        bigint id PK
        bigint model_id FK
        text code "GoLiveDate"
        text data_type_code FK
        bigint pick_list_id FK
        text unit
        text column_name "go_live_date"
    }
    ITEM_ATTRIBUTE {
        bigint id PK
        bigint attribute_type_id FK
        bigint entity_type_id FK "or"
        bigint relationship_type_id FK
        bool is_required
        text section
    }
    PICK_LIST {
        bigint id PK
        bigint model_id FK
        text code
    }
    PICK_LIST_VALUE {
        bigint id PK
        bigint pick_list_id FK
        text value
    }
    VALIDATION_RULE {
        bigint id PK
        bigint attribute_type_id FK "or field_name"
        bigint entity_type_id FK "empty = all types"
        text rule_type_code FK
        text param1
        text param2
        text severity
    }
    ALLOWED_RELATIONSHIP {
        bigint id PK
        bigint relationship_type_id FK
        bigint source_type_id FK
        bigint target_type_id FK
    }
    ENTITY {
        bigint id PK
        uuid guid UK
        bigint model_id FK
        bigint entity_type_id FK
        text display_id "APP-0012"
        text name
        text description
        bigint parent_entity_id FK
    }
    RELATIONSHIP {
        bigint id PK
        bigint model_id FK
        bigint relationship_type_id FK
        bigint source_entity_id FK
        bigint target_entity_id FK
    }
    ATTRIBUTE_VALUE {
        bigint id PK
        bigint attribute_type_id FK
        bigint entity_id FK "or"
        bigint relationship_id FK
        text value_text
        numeric value_number
        date value_date
        bool value_bool
        bigint value_ref FK "link to entity"
    }
    ITEM_STATUS {
        text code PK "created under_review published retired"
    }
    MODEL_KIND {
        text code PK
        bool holds_content
        bool read_only
    }
    DATA_TYPE {
        text code PK
        text storage "text number date boolean ref"
        text sql_type
    }
    RULE_TYPE {
        text code PK
    }
    HISTORY_ROW_VERSIONS {
        bigint id PK
        text table_name
        bigint row_id
        uuid row_guid
        int row_version
        text operation
        jsonb data
        text label
    }
