%%{init: {'theme':'neutral', 'themeVariables': {'fontSize':'15px'}}}%%
erDiagram
    MODEL_KINDS ||--o{ MODELS : "kind"
    MODELS |o--o{ MODELS : "parent (merges into, any depth)"
    MODELS |o--o{ MODELS : "source (created or copied from)"
    MODELS ||--o{ LAYERS : "owns"
    MODELS ||--o{ ENTITY_TYPES : "owns"
    MODELS ||--o{ RELATIONSHIP_TYPES : "owns"
    MODELS ||--o{ ATTRIBUTE_TYPES : "owns"
    MODELS ||--o{ PICK_LISTS : "owns"
    MODELS ||--o{ ENTITIES : "contains"
    MODELS ||--o{ RELATIONSHIPS : "contains"
    LAYERS ||--o{ ENTITY_TYPES : "groups"
    PICK_LISTS ||--o{ PICK_LIST_VALUES : "values"
    PICK_LISTS |o--o{ ATTRIBUTE_TYPES : "values from"
    DATA_TYPES ||--o{ ATTRIBUTE_TYPES : "typed as"
    ATTRIBUTE_TYPES ||--o{ ITEM_ATTRIBUTES : "applies via"
    ENTITY_TYPES |o--o{ ITEM_ATTRIBUTES : "has"
    RELATIONSHIP_TYPES |o--o{ ITEM_ATTRIBUTES : "has"
    ATTRIBUTE_TYPES |o--o{ VALIDATION_RULES : "checked by"
    RULE_TYPES ||--o{ VALIDATION_RULES : "rule"
    RELATIONSHIP_TYPES ||--o{ ALLOWED_RELATIONSHIPS : "allowed as"
    ENTITY_TYPES ||--o{ ALLOWED_RELATIONSHIPS : "source / target"
    ENTITY_TYPES ||--o{ ENTITIES : "typed by"
    ENTITIES |o--o{ ENTITIES : "parent"
    RELATIONSHIP_TYPES ||--o{ RELATIONSHIPS : "typed by"
    ENTITIES ||--o{ RELATIONSHIPS : "source / target"
    ENTITIES |o--o{ ATTRIBUTE_VALUES : "has"
    RELATIONSHIPS |o--o{ ATTRIBUTE_VALUES : "has"
    ATTRIBUTE_TYPES ||--o{ ATTRIBUTE_VALUES : "typed by"
    ITEM_STATUSES ||--o{ ENTITIES : "status (every table)"

    MODELS {
        bigint id PK
        uuid guid UK
        text name
        text kind_code FK "template reference project"
        bigint parent_model_id FK "merges into"
        bigint source_model_id FK "created from"
        text metamodel_name "ArchiMate 4"
        int metamodel_version
        bool is_locked "read-only"
    }
    LAYERS {
        bigint id PK
        bigint model_id FK
        text code
        text name "Business, Application..."
        text colour
    }
    ENTITY_TYPES {
        bigint id PK
        bigint model_id FK
        bigint layer_id FK
        text code "ApplicationComponent"
        text name "Application Component"
        text id_prefix "APP"
        text table_name "application_component"
    }
    RELATIONSHIP_TYPES {
        bigint id PK
        bigint model_id FK
        text code "Serving"
        text verb "serves"
        text category
        bool is_directed
    }
    ATTRIBUTE_TYPES {
        bigint id PK
        bigint model_id FK
        text code "GoLiveDate"
        text data_type_code FK
        bigint pick_list_id FK
        text unit
        text column_name "go_live_date"
    }
    ITEM_ATTRIBUTES {
        bigint id PK
        bigint attribute_type_id FK
        bigint entity_type_id FK "or"
        bigint relationship_type_id FK
        bool is_required
        text section
    }
    PICK_LISTS {
        bigint id PK
        bigint model_id FK
        text code
    }
    PICK_LIST_VALUES {
        bigint id PK
        bigint pick_list_id FK
        text value
    }
    VALIDATION_RULES {
        bigint id PK
        bigint attribute_type_id FK "or field_name"
        bigint entity_type_id FK "empty = all types"
        text rule_type_code FK
        text param1
        text param2
        text severity
    }
    ALLOWED_RELATIONSHIPS {
        bigint id PK
        bigint relationship_type_id FK
        bigint source_type_id FK
        bigint target_type_id FK
    }
    ENTITIES {
        bigint id PK
        uuid guid UK
        bigint model_id FK
        bigint entity_type_id FK
        text display_id "APP-0012"
        text name
        text description
        bigint parent_entity_id FK
    }
    RELATIONSHIPS {
        bigint id PK
        bigint model_id FK
        bigint relationship_type_id FK
        bigint source_entity_id FK
        bigint target_entity_id FK
    }
    ATTRIBUTE_VALUES {
        bigint id PK
        bigint attribute_type_id FK
        bigint entity_id FK "or"
        bigint relationship_id FK
        text value_text
        numeric value_number
        date value_date
        bool value_bool
        bigint value_ref FK "link to entity"
    }
    ITEM_STATUSES {
        text code PK "created under_review published retired"
    }
    MODEL_KINDS {
        text code PK
        bool holds_content
        bool read_only
    }
    DATA_TYPES {
        text code PK
        text storage "text number date boolean ref"
        text sql_type
    }
    RULE_TYPES {
        text code PK
    }
    HISTORY_ROW_VERSIONS {
        bigint id PK
        text table_name
        bigint row_id
        uuid row_guid
        int row_version
        text operation
        jsonb data
        text label
    }
