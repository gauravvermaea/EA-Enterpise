# EA Explorer proxy (nginx, used as is). The nginx image fills in ${EAX_...} values at start.
# Upstreams are looked up per request through Docker's DNS, so the proxy still starts when an
# optional container is not running.

resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The maintenance page (D230): while work/proxy/maintenance exists (a restore, an upgrade, .\eax maintenance on) every
# proxied location answers 503, and nginx answers 502 or 504 whenever an upstream is down (for example while the
# containers start); error_page turns each into the plain "under maintenance" page (the API and MCP: a short JSON
# answer). The page's own locations have no check, so the redirect to them always works.

# Shared proxy settings
proxy_http_version 1.1;
proxy_set_header Host              $host:${EAX_HTTPS_PORT};
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  ${EAX_HTTPS_PORT};
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $connection_upgrade;
proxy_set_header X-EAX-Client-Cert "";   # phase 25: only the machine-access port passes a client certificate on
proxy_buffer_size        128k;
proxy_buffers            4 256k;
proxy_busy_buffers_size  256k;
proxy_read_timeout       300s;

ssl_certificate     /etc/nginx/tls/tls.crt;
ssl_certificate_key /etc/nginx/tls/tls.key;
ssl_protocols       TLSv1.2 TLSv1.3;
# tls.crt is the site certificate followed by the local CA (D107), or your organisation's chain

# the version of nginx is not told in any answer (R2.0.1, the self-test's header checks)
server_tokens off;

# ---- plain HTTP (D107): the API (with Swagger) and the MCP server answer on http too when
# EAX_HTTP_API_MCP is true (laptops: for MCP clients and tools that cannot use a certificate; the laptop
# binds port 80 to this computer only). Everything else, and everything on servers, goes to HTTPS.
server {
    listen 80 default_server;
    server_name _;
    client_max_body_size 100m;   # model packages are uploaded to the API (phase 4)
    set $plain_api "${EAX_HTTP_API_MCP}";

    # ---- maintenance (D230)
    error_page 502 503 504 /eax-maintenance.html;
    location = /eax-maintenance.html { root /etc/nginx/eax; internal; add_header Cache-Control "no-store" always; add_header Retry-After 30 always; }
    location = /eax-maintenance.json { root /etc/nginx/eax; internal; default_type application/json; add_header Cache-Control "no-store" always; }
    location = /eax-unavailable-operations.json { root /etc/nginx/eax; internal; default_type application/json; add_header Cache-Control "no-store" always; }
    location = /eax-unavailable-personal.json { root /etc/nginx/eax; internal; default_type application/json; add_header Cache-Control "no-store" always; }

    location /api/ {
        if ($plain_api != "true") { return 301 https://$host:${EAX_HTTPS_PORT}$request_uri; }
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_API_UPSTREAM};
        proxy_set_header Host              $host:${EAX_HTTP_PORT};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-EAX-Client-Cert "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTP_PORT};
        proxy_pass $upstream;
    }

    location /api/v1/operations/ {   # the operations service (R2.27 part 2)
        if ($plain_api != "true") { return 301 https://$host:${EAX_HTTPS_PORT}$request_uri; }
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 503 /eax-maintenance.json;
        error_page 502 504 /eax-unavailable-operations.json;   # only this service is away: the rest works
        set $upstream http://${EAX_OPERATIONS_UPSTREAM};
        proxy_set_header Host              $host:${EAX_HTTP_PORT};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-EAX-Client-Cert "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTP_PORT};
        proxy_pass $upstream;
    }

    location = /api/v1/me {   # who am I and my roles: the main API. Exact, or nginx answers
        # /api/v1/me with a 301 to /api/v1/me/ below, the personal service answers 404 and no role shows
        if ($plain_api != "true") { return 301 https://$host:${EAX_HTTPS_PORT}$request_uri; }
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_API_UPSTREAM};
        proxy_set_header Host              $host:${EAX_HTTP_PORT};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-EAX-Client-Cert "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTP_PORT};
        proxy_pass $upstream;
    }
    location /api/v1/me/ {   # the personal data service (R2.53)
        if ($plain_api != "true") { return 301 https://$host:${EAX_HTTPS_PORT}$request_uri; }
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 503 /eax-maintenance.json;
        error_page 502 504 /eax-unavailable-personal.json;   # only this service is away: the rest works
        set $upstream http://${EAX_PERSONAL_UPSTREAM};
        proxy_set_header Host              $host:${EAX_HTTP_PORT};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-EAX-Client-Cert "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTP_PORT};
        proxy_pass $upstream;
    }

    location /api/library/ {
        if ($plain_api != "true") { return 301 https://$host:${EAX_HTTPS_PORT}$request_uri; }
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_LIBRARY_UPSTREAM};               # the library service (D346)
        proxy_set_header Host              $host:${EAX_HTTP_PORT};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-EAX-Client-Cert "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass $upstream;
    }

    location /api/views/ {
        if ($plain_api != "true") { return 301 https://$host:${EAX_HTTPS_PORT}$request_uri; }
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_VIEWS_UPSTREAM};                 # the views service (D405)
        client_max_body_size 12m;
        proxy_set_header Host              $host:${EAX_HTTP_PORT};
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-EAX-Client-Cert "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass $upstream;
    }

    location /mcp {
        if ($plain_api != "true") { return 301 https://$host:${EAX_HTTPS_PORT}$request_uri; }
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://api:8001;
        proxy_set_header Host              $host:${EAX_HTTP_PORT};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-EAX-Client-Cert "";
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTP_PORT};
        proxy_pass $upstream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        return 301 https://$host:${EAX_HTTPS_PORT}$request_uri;
    }
}

# ---- main site: our screens, the API, Keycloak, draw.io
server {
    listen 443 ssl default_server;
    server_name ${EAX_HOSTNAME};
    client_max_body_size 100m;

    # ---- maintenance (D230)
    error_page 502 503 504 /eax-maintenance.html;
    location = /eax-maintenance.html { root /etc/nginx/eax; internal; add_header Cache-Control "no-store" always; add_header Retry-After 30 always; }
    location = /eax-maintenance.json { root /etc/nginx/eax; internal; default_type application/json; add_header Cache-Control "no-store" always; }
    location = /eax-unavailable-operations.json { root /etc/nginx/eax; internal; default_type application/json; add_header Cache-Control "no-store" always; }
    location = /eax-unavailable-personal.json { root /etc/nginx/eax; internal; default_type application/json; add_header Cache-Control "no-store" always; }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # only this site may show its pages in a frame (draw.io at /drawio/ is this site) (R2.0.1, the self-test's header checks)
    add_header X-Frame-Options SAMEORIGIN always;
    # HSTS only where the certificate is trusted by everyone (servers). On a laptop it stays off, so
    # people who do not run "eax trust" can still accept the browser warning, as before (D107).
    add_header Strict-Transport-Security "${EAX_HSTS}" always;

    location / {
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        set $upstream http://web:8080;
        proxy_pass $upstream;
        # the screens' Content-Security-Policy (R3.12, D672): scripts only from this site (and the one line of Keycloak's
        # silent sign-in page, by its hash), no eval, no plugins, frames only from this site (draw.io, the sign-in);
        # styles may be inline (the terminal and the charts set them). Only here: draw.io (/drawio/), the API's own pages
        # (/api/docs), Keycloak (/auth/), Reports and Documents keep their own. EAX_CSP_HEADER=Content-Security-Policy-
        # Report-Only only reports. A location with headers of its own does not inherit the server's: repeated here.
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Strict-Transport-Security "${EAX_HSTS}" always;
        add_header ${EAX_CSP_HEADER} "default-src 'self'; script-src 'self' 'sha256-NuGEHWbQP7fFayUad46pwOQjhf59O6x6VUaef+Cctms='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    }

    location /api/ {
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_API_UPSTREAM};
        proxy_pass $upstream;
    }

    location /api/v1/operations/ {   # the operations service (R2.27 part 2)
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 503 /eax-maintenance.json;
        error_page 502 504 /eax-unavailable-operations.json;   # only this service is away: the rest works
        set $upstream http://${EAX_OPERATIONS_UPSTREAM};
        proxy_pass $upstream;
    }

    location = /api/v1/me {   # who am I and my roles: the main API. Exact, or nginx answers
        # /api/v1/me with a 301 to /api/v1/me/ below, the personal service answers 404 and no role shows
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_API_UPSTREAM};
        proxy_pass $upstream;
    }
    location /api/v1/me/ {   # the personal data service (R2.53)
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 503 /eax-maintenance.json;
        error_page 502 504 /eax-unavailable-personal.json;   # only this service is away: the rest works
        set $upstream http://${EAX_PERSONAL_UPSTREAM};
        proxy_pass $upstream;
    }

    # the library service (phase 15.2, D346): its own API, beside the main one
    location /api/library/ {
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_LIBRARY_UPSTREAM};
        proxy_pass $upstream;
    }

    # the views service (phase 28, D405): drawn views, their versions and the models' own views
    location /api/views/ {
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://${EAX_VIEWS_UPSTREAM};
        client_max_body_size 12m;
        proxy_pass $upstream;
    }

    # MCP server (Streamable HTTP): no buffering, long-lived responses
    location /mcp {
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        error_page 502 503 504 /eax-maintenance.json;
        set $upstream http://api:8001;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTPS_PORT};
        proxy_pass $upstream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # OAuth discovery for the MCP remote connector (D483): answered by the MCP server, no sign-in
    location /.well-known/oauth-protected-resource {
        set $upstream http://api:8001;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTPS_PORT};
        proxy_pass $upstream;
    }
    location /.well-known/oauth-authorization-server {
        set $upstream http://api:8001;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  ${EAX_HTTPS_PORT};
        proxy_pass $upstream;
    }

    location /auth/ {
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        set $upstream http://keycloak:8080;
        proxy_pass $upstream;
    }

    # Interactive terminals in containers (D214): a WebSocket to the operations helper's terminal port, which answers
    # nothing else and only with a one-time ticket the API gives IT and Super Admins. Reached over the "terminal"
    # network that only this proxy and the helper share. Sessions end on their own after the idle time (in the helper).
    location /ops-terminal/ {
        set $upstream http://ops:8091;
        rewrite ^/ops-terminal/(.*)$ /terminal/$1 break;
        proxy_pass $upstream;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # While a backup is restored (D227) the screens ask here, not the API (which may be stopped): whether a restore runs
    # (for the lock page; nothing secret) and, with the token only its starter has, its status and log.
    location /ops-restore/ {
        set $upstream http://ops:8091;
        rewrite ^/ops-restore/(.*)$ /restore/$1 break;
        proxy_pass $upstream;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
    }

    location /drawio/ {
        if (-f /eax-proxy/maintenance) { return 503; }   # D230
        set $upstream http://drawio:8080;
        rewrite ^/drawio/(.*)$ /$1 break;
        proxy_pass $upstream;
    }
}

