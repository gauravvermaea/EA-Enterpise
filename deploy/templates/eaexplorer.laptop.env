# =====================================================================================
# EA Explorer configuration - LAPTOP deployment
# One file holds every setting that differs between installations.
#
#   1. Copy this file to  work/eaexplorer.env  (the work folder is never committed)
#      (.\eax.ps1 init  or  ./eax.sh init  does this)
#   2. .\eax.ps1 up   (Windows)   or   ./eax.sh up   (Linux / macOS)
#
# DEVELOPMENT ONLY: every password is P^55w0rd1234& and they are printed on the console
# (.\eax.ps1 logins). Never use this file on a server or with real data.
# =====================================================================================

# ---- Deployment -------------------------------------------------------------------
EAX_DEPLOYMENT=laptop
EAX_VERSION=dev
COMPOSE_PROFILES=dev

# ---- Site ---------------------------------------------------------------------------
# Users open https://EAX_HOSTNAME. Superset opens at https://reports.EAX_HOSTNAME and
# Mayan EDMS at https://docs.EAX_HOSTNAME. On a laptop, *.localhost resolves to this machine
# in Chrome, Edge and Firefox.
EAX_HOSTNAME=localhost
EAX_HTTPS_PORT=443
EAX_HTTP_PORT=80
EAX_ORG_NAME=My organisation
EAX_TIMEZONE=Africa/Johannesburg

# ---- Storage --------------------------------------------------------------------------
# A plain name (eax-...) is a Docker volume. A path (./work/data/..., /srv/eax/...) is a host folder.
# On Windows keep Docker volumes for the database: PostgreSQL cannot run on an NTFS folder.
EAX_DATA_DIR=eax-pgdata
EAX_DOCS_DIR=eax-docs
EAX_BACKUP_DIR=./work/data/backups
EAX_IMPORT_DIR=./work/data/imports
EAX_EXPORT_DIR=./work/data/exports
# Folder holding tls.crt and tls.key. If empty, a self-signed certificate is created on first start.
EAX_TLS_DIR=./work/data/tls

# ---- Database passwords (development: all the same) ------------------------------
EAX_DB_NAME=eaexplorer
EAX_DB_SUPERUSER_PASSWORD=P^55w0rd1234&
EAX_DB_PASSWORD=P^55w0rd1234&
EAX_DB_REPORT_PASSWORD=P^55w0rd1234&
EAX_KEYCLOAK_DB_PASSWORD=P^55w0rd1234&
EAX_SUPERSET_DB_PASSWORD=P^55w0rd1234&
EAX_MAYAN_DB_PASSWORD=P^55w0rd1234&
# Valkey, the task queue used only by Mayan EDMS
EAX_DMS_BROKER_PASSWORD=P^55w0rd1234&
# The same password URL-encoded (^ -> %5E, & -> %26): used inside connection URLs
EAX_DMS_BROKER_PASSWORD_URLENC=P%5E55w0rd1234%26

# ---- Identity (Keycloak) --------------------------------------------------------------
# Keycloak administrator (the Keycloak admin console at https://EAX_HOSTNAME/auth/admin)
EAX_KC_ADMIN=kcadmin
EAX_KC_ADMIN_PASSWORD=P^55w0rd1234&
# First EA Explorer user. On a laptop the password is not temporary (no change asked at sign-in).
EAX_FIRST_ADMIN_USER=eaadmin
EAX_FIRST_ADMIN_EMAIL=eaadmin@example.org
EAX_FIRST_ADMIN_PASSWORD=P^55w0rd1234&
EAX_FIRST_ADMIN_PASSWORD_TEMPORARY=false
# Client secrets Keycloak shares with Superset and Mayan
EAX_SUPERSET_OIDC_SECRET=P^55w0rd1234&
EAX_MAYAN_OIDC_SECRET=P^55w0rd1234&
# Identity sources: local now; ldap, entra and google come in later phases
EAX_IDP=local

# ---- Reports (Superset) -----------------------------------------------------------
EAX_SUPERSET_SECRET_KEY=P^55w0rd1234&
# Break-glass Superset administrator; normal sign-in is through Keycloak
EAX_SUPERSET_ADMIN_PASSWORD=P^55w0rd1234&

# ---- Documents (Mayan EDMS) -------------------------------------------------------
EAX_MAYAN_ADMIN_USER=admin
EAX_MAYAN_ADMIN_PASSWORD=P^55w0rd1234&

# ---- Repository -------------------------------------------------------------------
# Load the sample insurance model on first start (a few applications, capabilities and goals)
EAX_SEED_SAMPLE=true

# ---- Mail ---------------------------------------------------------------------------
# On a laptop all mail goes to Mailpit, readable at https://EAX_HOSTNAME/mail/
EAX_SMTP_HOST=mail
EAX_SMTP_PORT=1025
EAX_SMTP_USER=
EAX_SMTP_PASSWORD=
EAX_MAIL_FROM=EA Explorer <eax@localhost>

# ---- Backup -------------------------------------------------------------------------
# Cron schedule (minute hour day month weekday) and days of daily backups to keep
EAX_BACKUP_SCHEDULE=0 2 * * *
EAX_BACKUP_KEEP_DAILY=7

# ---- MCP server ---------------------------------------------------------------------
# Connect your own language model: http://localhost:8001/mcp (laptop) or https://EAX_HOSTNAME/mcp
EAX_MCP_ENABLED=true
# Laptop only: a fixed bearer token for MCP clients, so you need not paste Keycloak tokens
EAX_MCP_DEV_TOKEN=P^55w0rd1234&

# ---- Image versions (pinned after the phase 0.2 tests) ----------------------------
EAX_IMAGE_NGINX=nginx:1.27-alpine
EAX_IMAGE_POSTGRES=postgres:17-alpine
EAX_IMAGE_VALKEY=valkey/valkey:8-alpine
EAX_IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:26.0
EAX_IMAGE_SUPERSET=apache/superset:4.1.2
EAX_IMAGE_MAYAN=mayanedms/mayanedms:s4
EAX_IMAGE_DRAWIO=jgraph/drawio:24.7.17
EAX_IMAGE_MAILPIT=axllent/mailpit:v1.32.0
