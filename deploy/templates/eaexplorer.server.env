# =====================================================================================
# EA Explorer configuration - SINGLE SERVER deployment
# One file holds every setting that differs between installations.
#
#   1. Copy this file to  work/eaexplorer.env  (the work folder is never committed)
#      (.\eax.ps1 init server  or  ./eax.sh init server  does this)
#   2. Change anything marked CHANGE ME and every change-me password (the setup step refuses to
#      start a server that still has them). Use long random passwords; in values containing $,
#      wrap the value in single quotes.
#   3. .\eax.ps1 up   (Windows)   or   ./eax.sh up   (Linux / macOS)
#
# work/eaexplorer.env holds secrets: the work folder is in .gitignore and must never be committed.
# =====================================================================================

# ---- Deployment -------------------------------------------------------------------
EAX_DEPLOYMENT=server
EAX_VERSION=dev

# ---- Site ---------------------------------------------------------------------------
# Users open https://EAX_HOSTNAME. Superset opens at https://reports.EAX_HOSTNAME and
# Mayan EDMS at https://docs.EAX_HOSTNAME: create DNS records for all three names (CHANGE ME).
EAX_HOSTNAME=ea.example.org
EAX_HTTPS_PORT=443
EAX_HTTP_PORT=80
# Machine access with client certificates (phase 25, D366): other systems present a certificate on this port
# (uploaded and trusted on System admin > Machine access). Browsers never use it.
EAX_MTLS_PORT=9443
# Plain http only redirects to https on a server (D107)
EAX_HTTP_BIND=0.0.0.0
EAX_HTTP_API_MCP=false
# Browsers keep to https for a year (needs a certificate everyone trusts)
EAX_HSTS=max-age=31536000
EAX_ORG_NAME=My organisation
EAX_TIMEZONE=Africa/Johannesburg

# ---- Storage --------------------------------------------------------------------------
# A plain name (eax-...) is a Docker volume. A path (./work/data/..., /srv/eax/...) is a host folder.
# On Windows keep Docker volumes for the database: PostgreSQL cannot run on an NTFS folder.
EAX_DATA_DIR=/srv/eax/postgres
EAX_DOCS_DIR=/srv/eax/documents
EAX_IMPORT_DIR=/srv/eax/imports
EAX_EXPORT_DIR=/srv/eax/exports
# Folder holding tls.crt and tls.key (your organisation's certificate covering EAX_HOSTNAME,
# reports.EAX_HOSTNAME and docs.EAX_HOSTNAME). If empty, a self-signed one is created.
EAX_TLS_DIR=/srv/eax/tls

# ---- Database passwords (CHANGE ME) -----------------------------------------------
EAX_DB_NAME=eaexplorer
EAX_DB_SUPERUSER_PASSWORD=change-me-superuser
EAX_DB_PASSWORD=change-me-app
EAX_DB_REPORT_PASSWORD=change-me-report
# The installer's login: the only one that may load or change locked reference models
EAX_DB_MIGRATOR_PASSWORD=change-me-migrator
EAX_KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
EAX_SUPERSET_DB_PASSWORD=change-me-superset-db
EAX_MAYAN_DB_PASSWORD=change-me-mayan-db
EAX_LIBRARY_DB_PASSWORD=change-me-library-db
# the main API's key for the library service's /internal calls (project backups, sample data), D346
EAX_LIBRARY_KEY=change-me-library-key
EAX_VIEWS_DB_PASSWORD=change-me-views-db
# the main API's key for the views service's /internal calls (tags, copies, merges, packages, MCP, sample data), D405
EAX_VIEWS_KEY=change-me-views-key
# ---- Operations helper (phase 10, D183) --------------------------------------------
# The shared secret between the API and the operations helper that restarts the system from the
# administration console. A server needs its own long random value.
EAX_OPS_TOKEN=change-me-ops

# ---- Change log (phase 9, D180) ---------------------------------------------------
# The change log's own connection string, so it can live on another database server and never slows the
# repository: postgresql://user:password@host:port/database (URL-encode the password: ^ -> %5E, & -> %26).
# Empty = the repository's database. The login needs to create the schema below (or have it made for it).
EAX_CHANGELOG_DB_URL=
# The schema the change log's tables go in (made on first start)
EAX_CHANGELOG_DB_SCHEMA=changelog

# ---- Architecture projects (phase 13, D266) ----------------------------------------
# The projects' own connection string (schema proj), so they can move to a database of their own later:
# postgresql://user:password@host:port/database (URL-encode the password). Empty = the repository's database (the
# usual; one transaction for both). Before setting it, copy the proj schema there (pg_dump -n proj | psql ...).
EAX_PROJECTS_DB_URL=


# Every container's log, one file a day, kept across resets (R2.32): empty = logs/ beside work/; a server puts it on a
# mounted disk, e.g. /srv/eax/logs. Cleaned every night after System Admin > Settings "Delete logs older than" (R2.30).
# EAX_LOGS_DIR=
# ---- Where each database lives (R2.50, D611; docs/databases.md) ---------------------------
# Every database has its own setting. Empty = the shared PostgreSQL (the db container), as usual; set one to move that
# database to a container or server of its own (dump it, restore it there, set the setting, restart). Connection
# strings: postgresql://user:password@host:port/database (URL-encode the password: ^ -> %5E, & -> %26).
# The change log and the projects have theirs above. The others are schemas of the one database (D630): empty = that
# schema here; set one to the address of another PostgreSQL database that already exists to scale it out (EA Explorer
# never creates a database), then eax up and eax databases copy KEY:
EAX_TESTS_DB_URL=
EAX_OPERATIONS_DB_URL=
EAX_PERSONAL_DB_URL=
EAX_LIBRARY_MODELS_DB_URL=
EAX_ARCHIVE_DB_URL=
# files on a platform with no local file system (EAX_FILE_STORE=database, R2.44): the files schema; empty = this database
EAX_FILES_DB_URL=
# the EA Explorer sites in the site picker (R2.1): the farm schema; empty = this database
EAX_FARM_DB_URL=
# The services' own databases: a host (and port) instead of db:5432 when one has a server of its own
EAX_KEYCLOAK_DB_HOST=
EAX_SUPERSET_DB_HOST=
EAX_MAYAN_DB_HOST=
# (the library's and the views' databases: EAX_LIBRARY_DB_HOST and EAX_VIEWS_DB_HOST, D410)

# Valkey, the task queue used only by Mayan EDMS
EAX_DMS_BROKER_PASSWORD=change-me-dms-broker
# The same password URL-encoded (for example @ -> %40, ^ -> %5E, & -> %26, $ -> %24): used inside connection URLs
EAX_DMS_BROKER_PASSWORD_URLENC=change-me-dms-broker

# ---- Identity (Keycloak) --------------------------------------------------------------
# The Keycloak realm of EA Explorer: its users, roles and clients. Choose it at the first install
# (lower-case letters, digits and hyphens, 2 to 40, starting with a letter; not "master"). Changing
# it later needs a clean install, because the realm and every user in it are created only once.
EAX_KEYCLOAK_REALM=eaexplorer
# Keycloak administrator (the Keycloak admin console at https://EAX_HOSTNAME/auth/admin)
EAX_KC_ADMIN=kcadmin
EAX_KC_ADMIN_PASSWORD=change-me-kcadmin
# First EA Explorer user. The password is temporary: Keycloak asks for a new one at first sign-in.
EAX_FIRST_ADMIN_USER=eaadmin
EAX_FIRST_ADMIN_EMAIL=eaadmin@example.org
EAX_FIRST_ADMIN_PASSWORD=change-me-first-admin
EAX_FIRST_ADMIN_PASSWORD_TEMPORARY=true
# Client secrets Keycloak shares with Superset and Mayan (any long random strings)
EAX_SUPERSET_OIDC_SECRET=change-me-superset-oidc
EAX_MAYAN_OIDC_SECRET=change-me-mayan-oidc
# The API's own Keycloak client (eax-admin): reads people and their roles; never changes them
EAX_KC_SERVICE_SECRET=change-me-kc-service-secret
# Break-glass account (D80): sign in as Super Admin when Keycloak is down (start page > "Keycloak is
# down?"). Generate a long random password, seal it (outside the product) and keep it only here.
# Every use is audited; the heartbeat warns until you change it after a use. Empty turns it off.
EAX_BREAK_GLASS_PASSWORD=change-me-break-glass-long-random
# Identity sources: local now; ldap, entra and google come in later phases
EAX_IDP=local

# ---- Reports (Superset) -----------------------------------------------------------
EAX_SUPERSET_SECRET_KEY=change-me-superset-secret-key-make-it-long
# Break-glass Superset administrator; normal sign-in is through Keycloak
EAX_SUPERSET_ADMIN_PASSWORD=change-me-superset-admin

# ---- Documents (Mayan EDMS) -------------------------------------------------------
EAX_MAYAN_ADMIN_USER=admin
EAX_MAYAN_ADMIN_PASSWORD=change-me-mayan-admin

# ---- Repository -------------------------------------------------------------------
# Load the sample insurance model on first start (a few applications, capabilities and goals)
EAX_SEED_SAMPLE=false

# ---- Backup -------------------------------------------------------------------------
# When backups run, how many are kept and when the health check warns: Administration > Backups (in the database,
# not in this file, D222). They are always in work/backups; to keep them elsewhere, mount a share there (D226).

# ---- SQL window ---------------------------------------------------------------------
# Start page > SQL: run queries with a database login (Super Admins and IT Admins only; keep off on servers unless you need it)
EAX_SQL_CONSOLE_ENABLED=false
# The container console (Administration > Containers): IT and Super Admins run commands and open interactive
# terminals inside the containers (D214). on or off; properties and logs are shown either way. Every command, and the
# start and end of every terminal, is in the audit trail.
EAX_CONTAINER_CONSOLE=off
# A terminal closes after this many minutes without typing; otherwise only when the person ends it.
EAX_TERMINAL_IDLE_MINUTES=15
# Remote instances (R2.2, D634): how a Super Admin proves who they are to a remote instance's host for an SSH session
# from the browser: ask (each time: the host's password, or a private key for that session only; nothing kept),
# stored (each person's private key kept with the instance, encrypted with EAX_REMOTE_SECRET_KEY), or server_key
# (this installation's own key, work/ssh/id_ed25519; put its public part on the hosts). Every session is recorded.
EAX_REMOTE_SSH_AUTH=ask
# stored only: 16 characters or more; changing it makes the kept keys unreadable (they are given again)
EAX_REMOTE_SECRET_KEY=
# Backups (R2.44, D635): never in a database. A server or container platform keeps them in a mounted folder (a network
# share or a volume) given here; eax init asks for it, and EA Explorer takes no backup until it is set.
EAX_BACKUP_DIR=
# Files (R2.44, D635): folder (the work folder, default) or database (the files schema, for a platform with no local
# file system); and the platform: compose (Docker on this machine, default) or managed (Swarm or another orchestrator)
EAX_FILE_STORE=folder
EAX_PLATFORM=compose

# ---- Services (D191) -----------------------------------------------------------------
# Optional services, each on or off (all on unless set to off). Also: eax services, eax service <name> on|off, or
# Administration > System settings > Services (the console keeps a dated copy of this file first, in
# work/config-history). The core (database, sign-in, API, web screens, proxy) is always on.
# Reports (Apache Superset), documents (Mayan EDMS), diagrams (draw.io), the MCP server for language models (/mcp),
# the change log (no new entries while off) and the backup container:
EAX_SERVICE_REPORTS=on
EAX_SERVICE_DOCUMENTS=on
EAX_SERVICE_DRAWIO=on
EAX_SERVICE_MCP=on
EAX_SERVICE_CHANGE_LOG=on
EAX_SERVICE_BACKUPS=on
EAX_SERVICE_LIBRARY=on
# drawn views (draw.io files of every model, D405, D408): off keeps them, the Views tab says the service is off
EAX_SERVICE_VIEWS=on

# ---- MCP server ---------------------------------------------------------------------
# Connect your own language model at https://EAX_HOSTNAME/mcp with a Keycloak access token
# Development token: ignored on servers (laptop only)
EAX_MCP_DEV_TOKEN=

# ---- Image versions (pinned after the phase 0.2 tests) ----------------------------
EAX_IMAGE_NGINX=nginx:1.27-alpine
EAX_IMAGE_POSTGRES=postgres:17-alpine
EAX_IMAGE_VALKEY=valkey/valkey:8-alpine
EAX_IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:26.0
EAX_IMAGE_SUPERSET=apache/superset:4.1.2
EAX_IMAGE_MAYAN=mayanedms/mayanedms:s4
EAX_IMAGE_DRAWIO=jgraph/drawio:32.6.10

# ---- API and job servers (D249): how many copies of the api container run. Each answers API calls (nginx spreads them)
# and runs background jobs (data quality measurements among them). Change it with .\eax servers <n> (or ./eax.sh servers
# <n>) or on Administration > Containers; 1 to 16.
EAX_API_SERVERS=2

# ---- Updates (D417): updating to a newer release from the web console (System admin > Updates) or eax update.
# The link of EA Explorer's public git repository (no credentials); versions are built on this host. Prod (the release
# branch, tags vX.Y.Z) is always offered; RC (tags vX.Y.Z-rc.N) and Latest (every commit on main) only when on.
EAX_UPDATE_GIT_URL=https://github.com/gauravvermaea/EA-Enterpise

# Industry pack sources (D584): every up, run, restart and clean-* copies what is new or changed from these folders into
# library/industry-packs first (quick when nothing changed), then EA Explorer loads them into Documents as it starts.
# Several folders separated by ;. Empty: `eax packs source <folder...>` (kept in persist/), else the owner's folders in
# the home folder; a folder that is not there is skipped.
# EAX_PACKS_SOURCE=C:\Users\me\Enterprise_Architecture\Industry Specific Guidance;C:\Users\me\Enterprise_Architecture\Sample_Repo
EAX_UPDATE_RC=off
EAX_UPDATE_LATEST=off

# ---- Scaling out (phase 36.3, D520 to D528; docs/phase-36.3.md)
# How many API and job servers: fixed (EAX_API_SERVERS) or by rules, set in System admin > Scaling (EAX_SCALE_*).
# Extra compose files from deploy/compose/scale, comma separated: standby (a database standby), shared-storage (files on
# an NFS share), primary (the database answers on this host's private address), api-host (an extra host with API
# servers only), library-host / library-elsewhere (the library on a server of its own).
EAX_COMPOSE_EXTRA=
# With standby: the replication login's password (CHANGE ME when used)
EAX_REPLICATION_PASSWORD=
# With shared-storage: the NFS server and the export holding docs, imports, exports and superset
EAX_NFS_SERVER=
EAX_NFS_PATH=/exports/eaexplorer
# With primary, api-host or library-host: this host's private address (never a public one)
EAX_PRIVATE_BIND=

# ---- Automated tests (phase 36.1, D367; eax test, System admin > Health > Tests)
# A staging server may have the test users (one per role) so every role is tested; never on production.
EAX_TEST_USERS=off
EAX_TEST_USER_PASSWORD=
# Self-test (R2.11): each run removes its own test data when it ends. 1 keeps it, to look into a failure; the next run
# removes it then.
EAX_TEST_KEEP_DATA=0
# Code coverage of the API while the self-test runs (D642): on measures which lines of EA Explorer's code run, kept with
# each run (coverage.html). It slows the API a little, so test installations only.
EAX_COVERAGE=off
# Container alerts (R2.19): the watcher looks every minute; off stops it. Told again after this many minutes while a
# problem lasts. Containers restarted on their own when not working (comma list; empty: none), at most N times an hour.
EAX_ALERTS=on
EAX_ALERT_REPEAT_MINUTES=60
EAX_ALERT_AUTO_RESTART=
EAX_ALERT_AUTO_RESTART_MAX=3
# Host levels (R2.16): amber at WARN, red and an alert at ALERT, in percent
EAX_HOST_WARN_CPU=80
EAX_HOST_ALERT_CPU=90
EAX_HOST_WARN_MEMORY=85
EAX_HOST_ALERT_MEMORY=95
EAX_HOST_WARN_DISK=80
EAX_HOST_ALERT_DISK=90
# Host levels count as an alert only after this many minutes in a row at the alert line (never while starting)
EAX_ALERT_HOST_MINUTES=10
