# =====================================================================================
# EA Explorer configuration - SINGLE SERVER deployment
# One file holds every setting that differs between installations.
#
#   1. Copy this file to  work/eaexplorer.env  (the work folder is never committed)
#      (.\eax.ps1 init server  or  ./eax.sh init server  does this)
#   2. Change anything marked CHANGE ME and every change-me password (the setup step refuses to
#      start a server that still has them). Use long random passwords; in values containing $,
#      wrap the value in single quotes.
#   3. .\eax.ps1 up   (Windows)   or   ./eax.sh up   (Linux / macOS)
#
# work/eaexplorer.env holds secrets: the work folder is in .gitignore and must never be committed.
# =====================================================================================

# ---- Deployment -------------------------------------------------------------------
EAX_DEPLOYMENT=server
EAX_VERSION=dev

# ---- Site ---------------------------------------------------------------------------
# Users open https://EAX_HOSTNAME. Superset opens at https://reports.EAX_HOSTNAME and
# Mayan EDMS at https://docs.EAX_HOSTNAME: create DNS records for all three names (CHANGE ME).
EAX_HOSTNAME=ea.example.org
EAX_HTTPS_PORT=443
EAX_HTTP_PORT=80
# Plain http only redirects to https on a server (D107)
EAX_HTTP_BIND=0.0.0.0
EAX_HTTP_API_MCP=false
# Browsers keep to https for a year (needs a certificate everyone trusts)
EAX_HSTS=max-age=31536000
EAX_ORG_NAME=My organisation
EAX_TIMEZONE=Africa/Johannesburg

# ---- Storage --------------------------------------------------------------------------
# A plain name (eax-...) is a Docker volume. A path (./work/data/..., /srv/eax/...) is a host folder.
# On Windows keep Docker volumes for the database: PostgreSQL cannot run on an NTFS folder.
EAX_DATA_DIR=/srv/eax/postgres
EAX_DOCS_DIR=/srv/eax/documents
EAX_BACKUP_DIR=/srv/eax/backups
EAX_IMPORT_DIR=/srv/eax/imports
EAX_EXPORT_DIR=/srv/eax/exports
# Folder holding tls.crt and tls.key (your organisation's certificate covering EAX_HOSTNAME,
# reports.EAX_HOSTNAME and docs.EAX_HOSTNAME). If empty, a self-signed one is created.
EAX_TLS_DIR=/srv/eax/tls

# ---- Database passwords (CHANGE ME) -----------------------------------------------
EAX_DB_NAME=eaexplorer
EAX_DB_SUPERUSER_PASSWORD=change-me-superuser
EAX_DB_PASSWORD=change-me-app
EAX_DB_REPORT_PASSWORD=change-me-report
# The installer's login: the only one that may load or change locked reference models
EAX_DB_MIGRATOR_PASSWORD=change-me-migrator
EAX_KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
EAX_SUPERSET_DB_PASSWORD=change-me-superset-db
EAX_MAYAN_DB_PASSWORD=change-me-mayan-db
# Valkey, the task queue used only by Mayan EDMS
EAX_DMS_BROKER_PASSWORD=change-me-dms-broker
# The same password URL-encoded (for example @ -> %40, ^ -> %5E, & -> %26, $ -> %24): used inside connection URLs
EAX_DMS_BROKER_PASSWORD_URLENC=change-me-dms-broker

# ---- Identity (Keycloak) --------------------------------------------------------------
# Keycloak administrator (the Keycloak admin console at https://EAX_HOSTNAME/auth/admin)
EAX_KC_ADMIN=kcadmin
EAX_KC_ADMIN_PASSWORD=change-me-kcadmin
# First EA Explorer user. The password is temporary: Keycloak asks for a new one at first sign-in.
EAX_FIRST_ADMIN_USER=eaadmin
EAX_FIRST_ADMIN_EMAIL=eaadmin@example.org
EAX_FIRST_ADMIN_PASSWORD=change-me-first-admin
EAX_FIRST_ADMIN_PASSWORD_TEMPORARY=true
# Client secrets Keycloak shares with Superset and Mayan (any long random strings)
EAX_SUPERSET_OIDC_SECRET=change-me-superset-oidc
EAX_MAYAN_OIDC_SECRET=change-me-mayan-oidc
# The API's own Keycloak client (eax-admin): reads people and their roles; never changes them
EAX_KC_SERVICE_SECRET=change-me-kc-service-secret
# Break-glass account (D80): sign in as Super Admin when Keycloak is down (start page > "Keycloak is
# down?"). Generate a long random password, seal it (outside the product) and keep it only here.
# Every use is audited; the heartbeat warns until you change it after a use. Empty turns it off.
EAX_BREAK_GLASS_PASSWORD=change-me-break-glass-long-random
# Identity sources: local now; ldap, entra and google come in later phases
EAX_IDP=local

# ---- Reports (Superset) -----------------------------------------------------------
EAX_SUPERSET_SECRET_KEY=change-me-superset-secret-key-make-it-long
# Break-glass Superset administrator; normal sign-in is through Keycloak
EAX_SUPERSET_ADMIN_PASSWORD=change-me-superset-admin

# ---- Documents (Mayan EDMS) -------------------------------------------------------
EAX_MAYAN_ADMIN_USER=admin
EAX_MAYAN_ADMIN_PASSWORD=change-me-mayan-admin

# ---- Repository -------------------------------------------------------------------
# Load the sample insurance model on first start (a few applications, capabilities and goals)
EAX_SEED_SAMPLE=false

# ---- Backup -------------------------------------------------------------------------
# Cron schedule (minute hour day month weekday) and days of daily backups to keep
EAX_BACKUP_SCHEDULE=0 2 * * *
EAX_BACKUP_KEEP_DAILY=7
# The health check (Heartbeat > Services) warns when the newest backup is older than this
EAX_BACKUP_MAX_AGE_HOURS=36

# ---- SQL window ---------------------------------------------------------------------
# Start page > SQL: run queries with a database login (Super Admins and IT Admins only; keep off on servers unless you need it)
EAX_SQL_CONSOLE_ENABLED=false

# ---- MCP server ---------------------------------------------------------------------
# Connect your own language model at https://EAX_HOSTNAME/mcp with a Keycloak access token
EAX_MCP_ENABLED=true
# Development token: ignored on servers (laptop only)
EAX_MCP_DEV_TOKEN=

# ---- Image versions (pinned after the phase 0.2 tests) ----------------------------
EAX_IMAGE_NGINX=nginx:1.27-alpine
EAX_IMAGE_POSTGRES=postgres:17-alpine
EAX_IMAGE_VALKEY=valkey/valkey:8-alpine
EAX_IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:26.0
EAX_IMAGE_SUPERSET=apache/superset:4.1.2
EAX_IMAGE_MAYAN=mayanedms/mayanedms:s4
EAX_IMAGE_DRAWIO=jgraph/drawio:24.7.17
