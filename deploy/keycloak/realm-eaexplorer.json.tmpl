{
  "realm": "${EAX_KEYCLOAK_REALM}",
  "displayName": "EA Explorer",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "eax-super-admin",
        "description": "EA Explorer Super Admin: everything, everywhere; also administers this realm",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "realm-admin"
            ]
          }
        }
      },
      {
        "name": "eax-it-admin",
        "description": "EA Explorer IT Admin: health, backups, jobs, logs, SQL window; not model content"
      },
      {
        "name": "eax-user-admin",
        "description": "EA Explorer User Admin: sees people, their roles and their models (not the models themselves); maps Keycloak roles to EA Explorer's global roles"
      },
      {
        "name": "eax-keycloak-admin",
        "description": "EA Explorer Keycloak Admin: administers this realm (users, roles, identity providers)",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "realm-admin"
            ]
          }
        }
      },
      {
        "name": "eax-model-creator",
        "description": "EA Explorer Model Creator: creates models and becomes the Model Admin of each model they create (roles on a model are given in EA Explorer, per model)"
      },
      {
        "name": "eax-library-admin",
        "description": "EA Explorer Library Admin: curates the model library: creates, publishes, promotes, uploads and withdraws library models"
      },
      {
        "name": "eax-user",
        "description": "EA Explorer User: may sign in; sees the models where they have a role (given per model in EA Explorer). Every new user has it"
      },
      {
        "name": "offline_access",
        "description": "Keycloak default: offline tokens"
      },
      {
        "name": "uma_authorization",
        "description": "Keycloak default: user-managed access"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-eaexplorer",
    "composite": true,
    "composites": {
      "realm": [
        "eax-user",
        "offline_access",
        "uma_authorization"
      ]
    }
  },
  "clients": [
    {
      "clientId": "eax-web",
      "name": "EA Explorer web screens",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "${EAX_PUBLIC_URL}/*",
        "${EAX_PUBLIC_URL_PORT}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${EAX_PUBLIC_URL}/*##${EAX_PUBLIC_URL_PORT}/*"
      },
      "protocolMappers": [
        {
          "name": "audience eax-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eax-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "directory groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "eax-api",
      "name": "EA Explorer API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "superset",
      "name": "Reports (Apache Superset)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EAX_SUPERSET_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${EAX_REPORTS_URL}/*",
        "${EAX_REPORTS_URL_PORT}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${EAX_REPORTS_URL}/*##${EAX_REPORTS_URL_PORT}/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "eax-odata",
      "name": "EA Explorer OData feed",
      "description": "Power BI and Excel read a model's OData feed with the person's user name and password, checked here (password grant only, no browser sign-in; D433). The person's own roles apply.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "audience eax-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eax-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "directory groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "eax-mcp",
      "name": "EA Explorer MCP connector",
      "description": "An AI app adds EA Explorer as a remote MCP connector and the person signs in here in the browser (authorization code with PKCE; D483). The token carries the person's own roles. Add the AI app's callback address to the redirect URIs.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "${EAX_PUBLIC_URL}/*",
        "${EAX_PUBLIC_URL_PORT}/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience eax-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eax-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "directory groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "eax-console",
      "name": "EA Explorer console",
      "description": "eax console --server: signs in on another device with a code (device sign-in), with the person's own roles (D330)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience eax-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eax-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "directory groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "eax-admin",
      "name": "EA Explorer API (reads users and roles)",
      "description": "Service account the API uses to list people and their roles; it never changes them",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EAX_KC_SERVICE_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "mayan",
      "name": "Documents (Mayan EDMS)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EAX_MAYAN_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${EAX_DOCS_URL}/*",
        "${EAX_DOCS_URL_PORT}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${EAX_FIRST_ADMIN_USER}",
      "email": "${EAX_FIRST_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "EA",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "${EAX_FIRST_ADMIN_PASSWORD}",
          "temporary": ${EAX_FIRST_ADMIN_PASSWORD_TEMPORARY}
        }
      ],
      "realmRoles": [
        "eax-super-admin",
        "offline_access",
        "uma_authorization"
      ],
      "clientRoles": {
        "account": [
          "view-profile",
          "manage-account"
        ]
      }
    },
    {
      "username": "service-account-eax-admin",
      "enabled": true,
      "serviceAccountClientId": "eax-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "view-realm",
          "manage-realm"
        ]
      }
    }
  ]
}
