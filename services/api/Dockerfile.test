# EA Explorer test runner image (phase 36.1, D367, D523): the API's own code, plus what the tests need: pytest,
# Playwright with Chromium (the browser journeys) and pip-audit (the Python dependency scan). Built with
#   docker compose --profile test build testrunner        (eax test does it)
# and started on demand by the operations helper (the Health page, eax test) or in CI. It builds its own test database
# and runs its own copy of the API on it: see eax/testing/__init__.py.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app
COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements.txt -r requirements-dev.txt "playwright==1.48.0" "pip-audit==2.7.3" \
 && python -m playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/*

COPY . .
RUN useradd --system --uid 10001 --home /app eax && mkdir -p /results && chown eax /results \
 && chmod -R a+rx /ms-playwright

USER eax
ENTRYPOINT ["python", "-m", "eax.testing"]
CMD ["run"]
